# Copie para .env e substitua todos os valores. Nunca versione .env.
POSTGRES_USER=automation
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-unica
POSTGRES_DB=automation
EVOLUTION_DB=evolution
REDIS_PASSWORD=troque-por-outra-senha-longa-e-unica

N8N_ENCRYPTION_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_SECURE_COOKIE=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

EVOLUTION_PORT=8080
AUTHENTICATION_API_KEY=gere-uma-api-key-longa-e-unica
EVOLUTION_LOG_LEVEL=WARN

# Valores repassados ao n8n pelos nodes. EVOLUTION_API_KEY usa AUTHENTICATION_API_KEY.
EVOLUTION_INSTANCE=prospeccao
GOOGLE_SHEET_ID=coloque-o-id-da-planilha