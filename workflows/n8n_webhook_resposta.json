    {
      "parameters": {
        "jsCode": "const norm = (v) => String(v ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\nconst campo = (obj, nome) => {\n  const chave = Object.keys(obj).find((k) => norm(k) === nome);\n  return chave === undefined ? undefined : obj[chave];\n};\nconst ativos = ['sim', 's', 'true', 'x', 'ativo', 'ativa', '1', 'yes'];\nconst saida = [];\n$input.all().forEach((item, idx) => {\n  const aba = String(campo(item.json, 'aba') ?? '').trim();\n  if (!aba || !ativos.includes(norm(campo(item.json, 'ativa')))) return;\n  const linha = parseInt(campo(item.json, 'linha inicial'), 10);\n  saida.push({ json: { aba, linhaInicial: Number.isFinite(linha) && linha > 0 ? linha : 4 }, pairedItem: { item: idx } });\n});\nreturn saida;"
      },
