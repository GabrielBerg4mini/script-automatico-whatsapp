{
  "name": "Prospecção Limeira - Webhook Respostas",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evolution-respostas",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook Evolution",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -900,
        0
      ],
      "webhookId": "evolution-respostas"
    },
    {
      "parameters": {
        "jsCode": "const data = $json.data ?? $json;\nconst key = data.key ?? {};\nif (key.fromMe === true) return [];\nconst raw = key.remoteJid ?? data.remoteJid ?? data.sender ?? '';\nconst telefone = String(raw).split('@')[0].replace(/\\D/g, '');\nconst texto = data.message?.conversation ?? data.message?.extendedTextMessage?.text ?? data.body ?? '';\nif (!telefone || telefone.length < 12) return [];\nreturn [{ json: { telefoneRecebido: telefone, texto: String(texto).slice(0, 500) } }];"
      },
      "id": "filter",
      "name": "Somente mensagens externas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.GOOGLE_SHEET_ID}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Limeira"
        },
        "options": {}
      },
      "id": "read-sheet",
      "name": "Ler contatos Limeira",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -440,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CONFIGURE_NO_N8N",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const normalizarTelefone = (valor) => {\n  const digits = String(valor ?? '').replace(/\\D/g, '');\n  return digits.startsWith('55') ? digits : `55${digits}`;\n};\nconst resposta = $('Somente mensagens externas').item.json;\nconst recebido = normalizarTelefone(resposta.telefoneRecebido);\nconst contato = $input.all().find((item) => normalizarTelefone(item.json['Telefone / WhatsApp']) === recebido);\nif (!contato) return [];\nreturn [{ json: { ...contato.json, telefonePlanilha: contato.json['Telefone / WhatsApp'], texto: resposta.texto } }];"
      },
      "id": "find-contact",
      "name": "Encontrar contato pelo telefone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.GOOGLE_SHEET_ID}}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Limeira"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{$json.row_number}}",
            "Status da Abordagem": "Cliente Respondeu",
            "Observações": "={{'Resposta recebida: ' + $json.texto}}"
          },
          "matchingColumns": [
            "row_number"
          ],
          "schema": [
            {
              "id": "row_number",
              "displayName": "row_number",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "readOnly": true,
              "removed": false
            }
          ]
        },
        "options": {}
      },
      "id": "update",
      "name": "Marcar cliente respondeu",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        40,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CONFIGURE_NO_N8N",
          "name": "Google Sheets account"
        }
      }
    }
  ],
