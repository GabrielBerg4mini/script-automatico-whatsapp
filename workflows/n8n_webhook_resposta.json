    {
      "parameters": {
        "jsCode": "const normalizarTelefone = (valor) => {\n  const digits = String(valor ?? '').replace(/\\D/g, '');\n  return digits.startsWith('55') ? digits : `55${digits}`;\n};\nconst resposta = $('Somente mensagens externas').first().json;\nconst recebido = normalizarTelefone(resposta.telefoneRecebido);\nconst todos = $input.all();\nconst indice = todos.findIndex((item) => normalizarTelefone(item.json['Telefone / WhatsApp']) === recebido);\nif (indice < 0) return [];\nconst aba = $('Abas ativas').itemMatching(indice).json.aba;\nconst contato = todos[indice].json;\nreturn [{ json: { ...contato, aba, telefonePlanilha: contato['Telefone / WhatsApp'], texto: resposta.texto } }];"
      },
